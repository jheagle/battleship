{
  "browser": {
    "name": "cloakfall"
  },
  "copyFiles": [
    {
      "from": "browser/*.js",
      "to": "../joshuaheagle.local/projects/cloakfall/browser"
    },
    {
      "from": "browser/css/*.css",
      "to": "../joshuaheagle.local/projects/cloakfall/browser/css"
    },
    {
      "from": "icons/*",
      "to": "../joshuaheagle.local/projects/cloakfall/icons"
    }
  ],
  "docs": {
    "bodyHtml": "<script data-goatcounter=\"https://joshuaheagle.goatcounter.com/count\" async src=\"//gc.zgo.at/count.js\"></script>",
    "enabled": true,
    "from": "src",
    "index": "MAIN.md",
    "to": "../joshuaheagle.local/projects/cloakfall/docs"
  },
  "lint": {
    "include": ["scripts"]
  },
  "readme": {
    "from": "dist/**/!(*.min).js"
  },
  "sass": {
    "enabled": true,
    "from": "sass/*.+(scss|sass)",
    "path": "sass",
    "to": "browser/css"
  },
  "typescript": {
    "config": "tsconfig.json",
    "enabled": true
  }
}

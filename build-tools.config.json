{
  "browser": {
    "name": "battleship"
  },
  "copyFiles": [
    {
      "from": "browser/*.js",
      "to": "../joshuaheagle.local/projects/battleship/browser"
    },
    {
      "from": "browser/css/*.css",
      "to": "../joshuaheagle.local/projects/battleship/browser/css"
    }
  ],
  "docs": {
    "enabled": true,
    "from": "src",
    "index": "MAIN.md",
    "to": "../joshuaheagle.local/projects/battleship/docs"
  },
  "readme": {
    "from": "dist/**/!(*.min).js"
  },
  "sass": {
    "enabled": true,
    "from": "sass/*.+(scss|sass)",
    "path": "sass",
    "to": "browser/css"
  },
  "typescript": {
    "config": "tsconfig.json",
    "enabled": true
  }
}

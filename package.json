{
  "name": "battleship",
  "version": "1.0.0",
  "description": "This is just a fun project creating a game of battleship. Experimenting with functional programming and ES6 features.",
  "main": "dist/main.js",
  "author": "Joshua Heagle",
  "license": "ISC",
  "scripts": {
    "build": "gulp build",
    "dev": "gulp",
    "htmldocs": "jsdoc -R MAIN.md -c ./.jsdoc.conf.js -d docs",
    "readme": "gulp readme",
    "resolutions": "npx npm-force-resolutions",
    "serve:lobby": "tsc server/lobbyServer.ts --ignoreConfig --outDir dist/server --rootDir . --module commonjs --target es2020 --moduleResolution node --esModuleInterop --skipLibCheck --ignoreDeprecations 6.0 && node dist/server/server/lobbyServer.js",
    "test": "gulp testFull",
    "test:quick": "gulp testQuick",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.type-tests.json",
    "watch": "gulp watchFull",
    "watch:test": "gulp watchTest"
  },
  "devDependencies": {
    "gulp": "^5.0.1",
    "js-build-tools": "^5.2.0",
    "test-filesystem": "^1.5.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "browser-or-node": "^3.0.0",
    "collect-your-stuff": "^2.1.2",
    "json-dom": "github:jheagle/JSON-DOM",
    "matrix-dom": "github:jheagle/matrix-DOM",
    "pseudo-dom": "^1.0.1",
    "si-funciona": "^2.7.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jheagle/battleship.git"
  },
  "bugs": {
    "url": "https://github.com/jheagle/battleship/issues"
  },
  "homepage": "https://github.com/jheagle/battleship#readme",
  "standard": {
    "env": [
      "jest"
    ]
  },
  "types": "dist/main.d.ts"
}

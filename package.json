{
  "name": "cloakfall",
  "version": "1.0.1",
  "description": "Cloakfall: a free-for-all, hidden-fleet grid game for 2 to 4 players and robots, in a dark sector of space. Built on treeloom and treeloom-matrix.",
  "main": "dist/main.js",
  "author": "Joshua Heagle",
  "license": "ISC",
  "scripts": {
    "build": "gulp build",
    "dev": "gulp",
    "e2e": "npm run e2e:robots && npm run e2e:hotseat && npm run e2e:online",
    "e2e:hotseat": "node scripts/e2e/hotseat.mjs",
    "e2e:online": "node scripts/e2e/online.mjs",
    "e2e:robots": "node scripts/e2e/robots.mjs",
    "readme": "gulp readme",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run",
    "resolutions": "npx npm-force-resolutions",
    "serve:lobby": "tsc server/lobbyServer.ts --ignoreConfig --outDir dist/server --rootDir . --module commonjs --target es2020 --moduleResolution node --esModuleInterop --skipLibCheck --ignoreDeprecations 6.0 && node dist/server/server/lobbyServer.js",
    "test": "gulp testFull",
    "test:quick": "gulp testQuick",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.type-tests.json",
    "watch": "gulp watchFull",
    "watch:test": "gulp watchTest",
    "docs": "gulp docs",
    "lint": "gulp lint"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "gulp": "^5.0.1",
    "js-build-tools": "^8.4.0",
    "playwright": "^1.65.0",
    "release-it": "^21.1.2",
    "test-filesystem": "^2.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "browser-or-node": "^3.0.0",
    "collect-your-stuff": "^2.2.1",
    "pseudo-dom": "^1.4.0",
    "si-funciona": "^2.10.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "treeloom": "^2.1.0",
    "treeloom-matrix": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jheagle/cloakfall.git"
  },
  "bugs": {
    "url": "https://github.com/jheagle/cloakfall/issues"
  },
  "homepage": "https://github.com/jheagle/cloakfall#readme",
  "standard": {
    "env": [
      "jest"
    ]
  },
  "types": "dist/main.d.ts",
  "allowScripts": {
    "core-js": false,
    "core-js-pure": false,
    "@parcel/watcher": false,
    "unrs-resolver": false,
    "esbuild": false
  }
}
